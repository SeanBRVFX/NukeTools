set cut_paste_input [stack 0]
version 15.1 v6
push $cut_paste_input
Group {
 name SR_MultiGrade
 knobChanged "n = nuke.thisNode()\nk = nuke.thisKnob()\nkn = k.name()\n\nif kn == \"method\":\n    blackpoint = n.knobs()\[\"blackpoint\"]\n    whitepoint = n.knobs()\[\"whitepoint\"]\n    lift = n.knobs()\[\"black\"]\n    gain = n.knobs()\[\"white\"]\n    multiply = n.knobs()\[\"multiply\"]\n    offset = n.knobs()\[\"add\"]\n    gamma = n.knobs()\[\"gamma\"]\n    reverse = n.knobs()\[\"reverse\"]\n    blackClamp = n.knobs()\[\"black_clamp\"]\n    whiteClamp = n.knobs()\[\"white_clamp\"]\n    merge = n.knobs()\[\"mergeMode\"]\n    mix = n.knobs()\[\"mix\"]\n    mixMerge = n.knobs()\[\"mix_merge\"]\n    preBlurBG = n.knobs()\[\"preBlurBG\"]\n    crop = n.knobs()\[\"crop\"]\n\n    parent = nuke.thisNode().parent()\n\n    if k.value() == \"grade\":\n        blackpoint.setVisible(True)\n        whitepoint.setVisible(True)\n        lift.setVisible(True)\n        gain.setVisible(True)\n        multiply.setVisible(True)\n        offset.setVisible(True)\n        gamma.setVisible(True)\n        reverse.setVisible(True)\n        blackClamp.setVisible(True)\n        whiteClamp.setVisible(True)\n        mix.setVisible(True)\n        merge.setVisible(False)\n        mixMerge.setVisible(False)\n        preBlurBG.setVisible(False)\n        crop.setVisible(False)\n\n    else:\n        blackpoint.setVisible(False)\n        whitepoint.setVisible(False)\n        lift.setVisible(False)\n        gain.setVisible(False)\n        multiply.setVisible(False)\n        offset.setVisible(False)\n        gamma.setVisible(False)\n        reverse.setVisible(False)\n        blackClamp.setVisible(False)\n        whiteClamp.setVisible(False)\n        merge.setVisible(True)\n        mix.setVisible(True)\n        mixMerge.setVisible(True)\n        preBlurBG.setVisible(True)\n        crop.setVisible(True)\n\n"
 tile_color 0x411050ff
 label "\[value method]\n\[expr \{\n    (\[value rY] && \[value gx] && \[value by]) ? \"RGB\" :\n    (\[value rY] && \[value gx] && !\[value by]) ? \"RB\" :\n    (\[value rY] && !\[value gx] && \[value by]) ? \"RG\" :\n    (!\[value rY] && \[value gx] && \[value by]) ? \"GB\" :\n    (\[value rY] && !\[value gx] && !\[value by]) ? \"R\" :\n    (!\[value rY] && \[value gx] && !\[value by]) ? \"G\" :\n    (!\[value rY] && !\[value gx] && \[value by]) ? \"B\" :\n    \"none\"\n\}]\[if \{\[value aaa]\} \{\n    return \"A\"\n\} \{return \"\"\}]\n\[if \{\[value mix]!=\"1\"\} \{return \"mix: \[expr \{\[value mix] * 100\}]%\"\} \{return \"\n\"\}]"
 note_font "Verdana Bold"
 selected true
 xpos -189
 ypos 80
 addUserKnob {20 yxy_grade l "SR MultiGrade"}
 addUserKnob {26 _4 l "" +STARTLINE T "<font color=\"#7a46d3\"><b>SR MultiGrade</font></b>"}
 addUserKnob {26 _3 l "" +STARTLINE T "<font color='#677'><i> v05, August 27 2025"}
 addUserKnob {26 _1 l "" +STARTLINE T "<font color='#777'>Made by <b>Sean Brian Rowlands\n"}
 addUserKnob {26 ""}
 addUserKnob {41 colorspace_in l colorspace T Colorspace8.colorspace_in}
 addUserKnob {4 method M {grade merge}}
 addUserKnob {6 logspace t "do an extra lin-log operation inside colorspace, especially good for edges" +STARTLINE}
 addUserKnob {26 spasce l "" +STARTLINE}
 addUserKnob {26 rText l " " T "<b><font color=#c22020>R</font></b>  "}
 addUserKnob {6 rY l "" -STARTLINE}
 rY true
 addUserKnob {26 gText l " " t cyan/red -STARTLINE T "<b><font color=#63ca39>G </font>"}
 addUserKnob {6 by l "" -STARTLINE}
 addUserKnob {26 bText l " " t magenta/green -STARTLINE T "<b><font color=#3d59cb>B</font></b>  "}
 addUserKnob {6 gx l "" -STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {41 mergeMode l merge +HIDDEN T Merge2.operation}
 addUserKnob {41 mix_merge l mixMerge +HIDDEN T Merge2.mix}
 addUserKnob {26 ""}
 addUserKnob {7 preBlurBG +HIDDEN R 0 150}
 preBlurBG 20
 addUserKnob {41 crop -STARTLINE +HIDDEN T bgBlur.crop}
 addUserKnob {41 blackpoint T Grade2.blackpoint}
 addUserKnob {41 whitepoint T Grade2.whitepoint}
 addUserKnob {41 black l lift T Grade2.black}
 addUserKnob {41 white l gain T Grade2.white}
 addUserKnob {41 multiply T Grade2.multiply}
 addUserKnob {41 add l offset T Grade2.add}
 addUserKnob {41 gamma T Grade2.gamma}
 addUserKnob {41 reverse T Grade2.reverse}
 addUserKnob {41 black_clamp l blackClamp -STARTLINE T Grade2.black_clamp}
 addUserKnob {41 white_clamp l whiteClamp -STARTLINE T Grade2.white_clamp}
 addUserKnob {26 ""}
 addUserKnob {6 checkAlpha l "Use input alpha?" t "if disabled, shuffles out a complete white alpha" +STARTLINE}
 checkAlpha true
 addUserKnob {7 mix l "mix effect"}
 mix 1
 addUserKnob {26 _2 l "" +STARTLINE}
 addUserKnob {20 grA l "grade Alpha" t "grade alpha separate" n 1}
 grA 0
 addUserKnob {26 _5 l "" +STARTLINE T "<b><font color=#FFFFFF>A</font></b>  "}
 addUserKnob {6 aaa l "" -STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {41 blackpoint_1 l blackpoint T Grade1.blackpoint}
 addUserKnob {41 whitepoint_1 l whitepoint T Grade1.whitepoint}
 addUserKnob {41 black_1 l lift T Grade1.black}
 addUserKnob {41 white_1 l gain T Grade1.white}
 addUserKnob {41 multiply_1 l multiply T Grade1.multiply}
 addUserKnob {41 add_1 l offset T Grade1.add}
 addUserKnob {41 gamma_1 l gamma T Grade1.gamma}
 addUserKnob {41 black_clamp_1 l "black clamp" T Grade1.black_clamp}
 addUserKnob {41 white_clamp_1 l "white clamp" -STARTLINE T Grade1.white_clamp}
 addUserKnob {26 ""}
 addUserKnob {20 endGroup n -1}
}
